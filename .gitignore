# Foundry build output
cache/
out/
broadcast/*/31337/
broadcast/**/dry-run/

# Secrets - never commit
.env

# Node (only used by the optional verification scripts in tools/)
node_modules/

# NOTE: `forge init` ships a .gitignore containing `docs/`, which would silently
# drop docs/screenshots/ from every commit. We deliberately do NOT ignore docs/,
# because the report screenshots live there and must be pushed.
